# Copy to /opt/terhal/<env>/app.env on the VPS (chmod 600) and fill in. Each environment has its own values; this file is
# never in git and deploys never touch it. Restart the stack after changing it: docker compose up -d --force-recreate
#
# Values below are for staging; for main set APP_ENV=production, drop ".staging" from the hosts
# and use the main Neon branch.

# staging or production. Decides which checks are relaxed for local development (none, here).
APP_ENV=staging

# Caddy overwrites this header with the caller's address (deploy/edge/Caddyfile), so rate limits can trust it.
CLIENT_IP_HEADER=x-real-ip

# The Neon branch's pooled URL (runtime) and direct URL (migrations only).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# This environment's three frontends. Each is the only browser origin allowed to call its own routes.
SITE_URL=https://staging.terhal.co
DASHBOARD_URL=https://dashboard.staging.terhal.co
ADMIN_URL=https://admin.staging.terhal.co

RESEND_KEY=
RESEND_EMAIL=Terhal Staging <no-reply@terhal.co>

# openssl rand -base64 32. Changing it signs every admin out.
ADMIN_SECRET=
# openssl rand -base64 32 each, all three different. Changing one signs that audience out.
STAFF_SECRET=
CUSTOMER_SECRET=
# openssl rand -base64 32. Changing it breaks every admin's authenticator setup.
TOTP_ENCRYPTION_KEY=

# Uploaded files go to a private Cloudflare R2 bucket; the server refuses to start unless the driver is s3 with every key
# below. The endpoint is https://<account id>.r2.cloudflarestorage.com. One bucket per environment (terhal-staging,
# terhal-production), each with its own R2 API token limited to Object Read & Write on that bucket.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=terhal-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
