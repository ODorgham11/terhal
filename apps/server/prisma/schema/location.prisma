// How broad a location is, broadest first. A location's children are usually one level narrower.
enum Locality {
  GOVERNORATE
  DISTRICT
  AREA
}

// Places, managed by admins. A tree: a governorate holds districts, a
// district holds areas and so on, as deep as needed. Soft deleted: pricing and past trips keep pointing at them.
model Location {
  id String @id @default(cuid())

  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId String?
  children Location[] @relation("LocationTree")

  locality Locality
  nameEn   String
  nameAr   String

  // Coverage: the area the platform serves around this place. Exactly one shape per locality (the Location_shape check):
  // a governorate has an outline (optional, (longitude, latitude) points), a district or an area has a center and a
  // radius, in meters. The application defaults the radius to 10 km.
  boundary  Unsupported("polygon")?
  latitude  Decimal?                @db.Decimal(9, 6)
  longitude Decimal?                @db.Decimal(9, 6)
  radius    Int?

  departures Pricing[] @relation("PricingFrom")
  arrivals   Pricing[] @relation("PricingTo")
  pickups    Trip[]    @relation("TripPickup")
  dropoffs   Trip[]    @relation("TripDropoff")
  offices    Office[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}
