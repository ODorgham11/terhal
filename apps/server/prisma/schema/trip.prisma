enum TripSource {
  CUSTOMER
  STAFF
}

enum TripStatus {
  PENDING
  CANCELLED
  CONFIRMED
  IN_PROGRESS
  AWAITING_REPORT
  COMPLETED
}

// Where a trip's price stands. A route without a price can still be booked; staff then propose one and the booker
// accepts it before the trip can be confirmed (Trip_price_state, Trip_priced_before_confirmed).
enum TripPriceState {
  // Priced from the price list at booking, or set by staff on a trip they booked.
  QUOTED
  // No price yet.
  REQUESTED
  // Staff proposed a price; the booker hasn't answered.
  PROPOSED
  // The booker accepted the proposed price.
  ACCEPTED
}

enum PaymentMethod {
  CASH_TO_DRIVER
  CASH_AT_OFFICE
  TRANSFER
  CARD
}

enum ExpenseType {
  INTERCITY_TOLL
  FUEL
  CAR_MAINTENANCE
  DRIVER_FEE
  // What an outside office is paid for a handed-off trip. Never reimbursed to the driver.
  OFFICE_FEE
  OTHER
}

// Trip classes, e.g. "Economy" / "VIP". Pricing is set per class.
model TripClass {
  id String @id @default(cuid())

  nameEn String
  nameAr String

  // What's included, for the booking page.
  descriptionEn String?
  descriptionAr String?
  sortOrder     Int     @default(0)

  archivedAt DateTime?

  trips   Trip[]
  pricing Pricing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt])
}

model Trip {
  id String @id @default(cuid())

  // Human-facing booking reference.
  code   String     @unique
  source TripSource
  status TripStatus @default(PENDING)

  // Who booked it: exactly one of customer, guest and staff, enforced by the Trip_one_booker check.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId String?

  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  guestSessionId String?

  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId String?

  // Created as optional initially until they are assigned by staff.
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId  String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleId String?

  // Set when the trip is handed off to an outside office, which supplies the driver and car.
  office   Office? @relation(fields: [officeId], references: [id], onDelete: Restrict)
  officeId String?

  // Report optional until created and linked by the driver.
  report TripReport?

  // Keep a log of all of the events that occur per the trip.
  events TripEvent[]

  // The class as it was named at booking time, so renaming a class later doesn't rewrite past trips.
  class         TripClass @relation(fields: [classId], references: [id])
  classId       String
  classSnapshot Json

  // The company the trip is sent under; empty for Terhal. Only staff bookings can have one (Trip_site_brand).
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  brandId String?

  clientName    String
  clientPhone   String
  pickupDate    DateTime
  smallLuggage  Int
  mediumLuggage Int
  largeLuggage  Int
  passengers    Int
  car           CarBody

  // What's charged. Empty only while a price is requested (Trip_price_state).
  totalPrice Decimal?       @db.Decimal(12, 2)
  priceState TripPriceState @default(QUOTED)

  paymentMethod PaymentMethod?
  paidAt        DateTime?

  // The booking request's Idempotency-Key, hashed together with the booker, so a retried request returns this trip.
  idempotencyKey String? @unique

  // The driver's report link, replaced when the driver changes. The token is an HMAC of the trip, its driver and this
  // random salt under a server key, so staff can show the link again; the database alone holds only its hash, which
  // finds the trip, and the salt, which is useless without the key (Trip_report_token: all three or none).
  reportTokenHash      String?   @unique
  reportTokenSalt      String?
  reportTokenExpiresAt DateTime?

  notes String?

  // The location the pin resolved to at booking, its names at the time (pickupSnapshot in English, pickupSnapshotAr in
  // Arabic), and the exact point within it.
  pickup           Location @relation("TripPickup", fields: [pickupId], references: [id])
  pickupId         String
  pickupSnapshot   String
  pickupSnapshotAr String
  pickupLatitude   Decimal  @db.Decimal(9, 6)
  pickupLongitude  Decimal  @db.Decimal(9, 6)

  dropoff           Location @relation("TripDropoff", fields: [dropoffId], references: [id])
  dropoffId         String
  dropoffSnapshot   String
  dropoffSnapshotAr String
  dropoffLatitude   Decimal  @db.Decimal(9, 6)
  dropoffLongitude  Decimal  @db.Decimal(9, 6)

  // Link a trip to another trip such that we can keep track of round-about trips.
  previousTrip   Trip?   @relation("TripChain", fields: [previousTripId], references: [id], onDelete: Restrict)
  previousTripId String? @unique

  subsequentTrip Trip? @relation("TripChain")

  driverTransactions DriverTransaction[]
  notifications      Notification[]
  reminders          NotificationReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, pickupDate])
  @@index([customerId])
  @@index([guestSessionId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([officeId])
  @@index([brandId])
}

model TripEvent {
  id String @id @default(cuid())

  // Who did it: exactly one of a staff member, a customer, a guest, the driver (through the report link) and the system,
  // enforced by the TripEvent_one_actor check.
  staff          Staff?        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId        String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId     String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  guestSessionId String?
  driver         Driver?       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId       String?
  // The background job or process behind a system event, e.g. "expire-pending-trips".
  system         String?

  trip   Trip   @relation(fields: [tripId], references: [id])
  tripId String

  // One of tripEventActions in @terhal/contracts.
  action String
  // What the event needs to be read on its own: statuses moved between, a reason, changed fields with before and after.
  data   Json?

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([customerId])
  @@index([guestSessionId])
  @@index([driverId])
}

model TripReport {
  id String @id @default(cuid())

  trip   Trip   @relation(fields: [tripId], references: [id])
  tripId String @unique

  startedAt     DateTime
  vehiclePickup String
  startMileage  Int

  pickupAt  DateTime
  dropoffAt DateTime

  vehicleDropoff String
  endedAt        DateTime
  endMileage     Int

  // Cash the driver collected from the customer for the company; zero when none. Enters the driver's ledger on
  // completion (CASH_COLLECTED).
  cashCollected Decimal @default(0) @db.Decimal(12, 2)

  stops    TripStop[]
  expenses TripExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripStop {
  id String @id @default(cuid())

  report   TripReport @relation(fields: [reportId], references: [id])
  reportId String

  // A stop is either an address or a pin, never both (TripStop_address_or_pin).
  locationId String?
  address    String?
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)

  startedAt DateTime
  endedAt   DateTime

  notes String?

  @@index([reportId])
}

model TripExpense {
  id String @id @default(cuid())

  report   TripReport @relation(fields: [reportId], references: [id])
  reportId String

  amount Decimal     @db.Decimal(12, 2)
  type   ExpenseType
  notes  String?

  @@index([reportId])
}
