enum CustomerStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationMethod {
  WHATSAPP
  EMAIL
}

// Someone booking through the customer site on terhal.co.
model Customer {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String         @unique
  email     String         @unique
  status    CustomerStatus @default(UNVERIFIED)
  locale    Locale         @default(ar)

  // Name, phone and email normalized for search (search_normalize), kept up to date by a trigger. Never written by the
  // app.
  search String @default("")

  passwordHash String

  // Method tells you which channel it was sent to.
  verificationHash      String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int                 @default(0)
  verificationMethod    VerificationMethod?

  // A new email or phone the customer asked to change to, waiting for the code above. It replaces the current one only
  // once the code is confirmed. At most one at a time (Customer_one_pending_change).
  pendingEmail String?
  pendingPhone String?

  verifiedVia VerificationMethod?
  verifiedAt  DateTime?

  // Hash of the single-use token in the latest password reset link. Requesting a new link replaces it, so only the newest one works.
  passwordResetHash      String?   @unique
  passwordResetExpiresAt DateTime?

  sessions      CustomerSession[]
  trips         Trip[]
  events        TripEvent[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerSession {
  id String @id @default(cuid())

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  refreshToken String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  @@index([customerId])
}

// Booking without an account. Guests confirm their contact details with a code emailed to them for now; it moves to
// WhatsApp once that's integrated.
model GuestSession {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String
  email     String
  locale    Locale @default(ar)

  tokenHash String @unique

  verificationHash      String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int       @default(0)
  verifiedAt            DateTime?

  expiresAt DateTime
  revokedAt DateTime?

  trips         Trip[]
  events        TripEvent[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}
