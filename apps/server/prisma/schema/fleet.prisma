// Fixed in code, ordered by size (SEDAN < SUV < MINIVAN < VAN, in contracts). Trip classes are editable, car bodies
// aren't.
enum CarBody {
  SEDAN
  SUV
  MINIVAN
  VAN
}

// Each kind of change to what the company owes a driver. The sign is fixed per kind (DriverTransaction_sign).
enum DriverTransactionType {
  // A completed trip's fee (every driver, paid per trip): positive.
  TRIP_FEE
  // A completed trip's expenses, all paid by the driver: positive.
  EXPENSE_REIMBURSEMENT
  // Cash the driver collected from the customer for the company: negative.
  CASH_COLLECTED
  // Money paid to the driver: negative.
  PAYOUT
  // Company cash the driver handed in: positive.
  CASH_HANDED_IN
  // A manual correction, either way.
  ADJUSTMENT
}

// An outside company the business works with, e.g. a car rental office or another transport operator. Archived
// instead of deleted, so anything that pointed at it keeps doing so.
model Office {
  id String @id @default(cuid())

  name    String  @unique
  contact String
  phone   String
  email   String?
  address String

  // Where the office is, to find offices near a pickup.
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationId String?

  drivers  Driver[]
  vehicles Vehicle[]
  trips    Trip[]

  notes String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt])
  @@index([locationId])
}

model Driver {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String @unique

  // What the company owes the driver, negative when the driver holds company cash. The running total of the driver's
  // ledger, kept by a trigger and never written directly (Driver_amount_owed_from_ledger).
  amountOwed Decimal @default(0) @db.Decimal(12, 2)

  // Unique whatever its case (Driver_licenseNumber_key, an index on lower(licenseNumber) in the migration).
  licenseNumber    String?
  licenseExpiresAt DateTime? @db.Date
  // 14 digits (Driver_national_id_format), one driver each.
  nationalId       String?   @unique
  // An external driver may work through an office. Only external drivers can (the Driver_office_is_external check).
  isExternal       Boolean   @default(false)
  office           Office?   @relation(fields: [officeId], references: [id], onDelete: Restrict)
  officeId         String?

  trips        Trip[]
  transactions DriverTransaction[]
  tripEvents   TripEvent[]

  notes String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([archivedAt])
}

// The driver's ledger: every change to Driver.amountOwed. Append-only.
model DriverTransaction {
  id String @id @default(cuid())

  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverId String

  type   DriverTransactionType
  // Positive when the company owes the driver more.
  amount Decimal               @db.Decimal(12, 2)

  // The trip it comes from; required for trip fees, reimbursements and cash collected (DriverTransaction_trip).
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId String?

  // Who recorded it; empty for the system.
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId String?

  note String?

  createdAt DateTime @default(now())

  @@index([driverId, createdAt])
  @@index([tripId])
}

model Vehicle {
  id String @id @default(cuid())

  make         String
  model        String
  year         Int?
  images       VehicleImage[]
  imageUploads VehicleImageUpload[]

  plateNumber String  @unique
  color       String
  body        CarBody

  // An external vehicle may come from an office. Only external vehicles can (the Vehicle_office_is_external check).
  isExternal Boolean @default(false)
  office     Office? @relation(fields: [officeId], references: [id], onDelete: Restrict)
  officeId   String?

  trips Trip[]

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([archivedAt])
}

model VehicleImage {
  id String @id @default(cuid())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  bucket String
  key    String @unique

  // 0 is the cover. At most 5 images per vehicle (VehicleImage_position).
  position Int

  createdAt DateTime @default(now())

  @@index([vehicleId])
}

// A photo on its way in. The dashboard asks for an upload and gets a signed link to put the file straight into storage
// (the bucket, or the local folder in development), then confirms it; only then is the file checked and made a
// VehicleImage. One never confirmed is swept with its file once its link has long expired (sweep-uploads).
model VehicleImageUpload {
  id String @id @default(cuid())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  // Who asked for it: only they can confirm it.
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId String

  bucket String
  key    String @unique

  // What the link was signed for: the storage refuses any other type or size (VehicleImageUpload_size).
  contentType String
  size        Int

  // When the link stops working.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([expiresAt])
}
