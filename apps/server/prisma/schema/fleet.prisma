// An outside company the business works with, e.g. a car rental office or another transport operator. Archived
// instead of deleted, so anything that pointed at it keeps doing so.
model Office {
  id String @id @default(cuid())

  name    String  @unique
  contact String
  phone   String
  email   String?
  address String

  // Where the office is, to find offices near a pickup.
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationId String?

  drivers  Driver[]
  vehicles Vehicle[]
  trips    Trip[]

  notes String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt])
  @@index([locationId])
}

model Driver {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String @unique

  amountOwed Decimal @db.Decimal(12, 2)
  // An external driver may work through an office. Only external drivers can (the Driver_office_is_external check).
  isExternal Boolean @default(false)
  office     Office? @relation(fields: [officeId], references: [id], onDelete: Restrict)
  officeId   String?

  trips Trip[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
}

model Vehicle {
  id String @id @default(cuid())

  make   String
  model  String
  year   Int?
  images VehicleImage[]

  plateNumber String @unique
  color       String

  // An external vehicle may come from an office. Only external vehicles can (the Vehicle_office_is_external check).
  isExternal Boolean @default(false)
  office     Office? @relation(fields: [officeId], references: [id], onDelete: Restrict)
  officeId   String?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
}

model VehicleImage {
  id String @id @default(cuid())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  bucket String
  key    String @unique

  createdAt DateTime @default(now())

  @@index([vehicleId])
}
