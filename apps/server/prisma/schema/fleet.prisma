// An outside company the business works with, e.g. a car rental office or another transport operator. Archived
// instead of deleted, so anything that pointed at it keeps doing so.
model Office {
  id String @id @default(cuid())

  name        String  @unique
  contactName String?
  phone       String?
  email       String?
  address     String?

  notes String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt])
}

model Driver {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String @unique

  amountOwed Decimal @db.Decimal(12, 2)
  isExternal Boolean @default(false)
  company    String?

  trips Trip[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id String @id @default(cuid())

  make   String
  model  String
  year   Int?
  images VehicleImage[]

  plateNumber String @unique
  color       String

  isExternal Boolean @default(false)
  office     String?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleImage {
  id String @id @default(cuid())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  bucket String
  key    String @unique

  createdAt DateTime @default(now())

  @@index([vehicleId])
}
