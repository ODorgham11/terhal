// Admins, signing in to admin.terhal.co. Separate from staff: their own accounts, sessions and cookies.

enum AdminStatus {
  ACTIVE
  INACTIVE
}

model Admin {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String      @unique
  status    AdminStatus @default(ACTIVE)

  passwordHash String

  totpSecret       String?
  totpEnabledAt    DateTime?
  totpLastUsedStep Int?
  lastLoginAt      DateTime?

  // A password reset link, hashed. Single use: cleared when it's used or replaced by a newer request.
  passwordResetHash      String?   @unique
  passwordResetExpiresAt DateTime?

  // A two-factor reset another admin started: a link to set up a new authenticator, hashed and single use.
  twoFactorResetHash      String?   @unique
  twoFactorResetExpiresAt DateTime?
  // The new authenticator being set up from that link, encrypted. Never accepted at sign in until it's confirmed, when it
  // moves to totpSecret.
  pendingTotpSecret       String?

  sessions    AdminSession[]
  logs        AuditLog[]
  invitations AdminInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInvitation {
  id String @id @default(cuid())

  email     String
  tokenHash String @unique

  // Empty for invitations sent by the seed, which runs before any admin exists.
  invitor   Admin?  @relation(fields: [invitorId], references: [id])
  invitorId String?

  // The two-factor secret being set up while accepting, encrypted. It moves to the admin once they confirm a code.
  totpSecret String?

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
}

model AdminSession {
  id           String @id @default(cuid())
  refreshToken String @unique
  adminId      String
  admin        Admin  @relation(fields: [adminId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?
}

model AuditLog {
  id String @id @default(cuid())

  // Who did it: an admin, a staff member, or neither (never both, the AuditLog_one_actor check). Neither when nobody is
  // behind the event: the seed sending an invitation, or a failed sign in for an email that doesn't belong to anyone.
  admin   Admin?  @relation(fields: [adminId], references: [id])
  adminId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId String?

  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?

  ipAddress String?

  createdAt DateTime @default(now())

  // The admin log lists newest first, filtered by who did it or what they did.
  @@index([createdAt, id])
  @@index([adminId, createdAt])
  @@index([staffId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}
