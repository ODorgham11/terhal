# development, staging or production. Only development gets local defaults and console emails.
APP_ENV=development

# Local values match infra/docker-compose.yml. Locally both URLs point at the same Postgres; on the VPS, DATABASE_URL is the
# Neon branch's pooled URL (runtime) and DATABASE_URL_UNPOOLED its direct URL (migrations).
# These win over the repo-root .env.local, which `neon env pull` writes only when you need to reach a Neon branch.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terhal
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/terhal

# Local values match infra/docker-compose.yml. On the VPS, deploy/compose.yml sets them to its own Redis containers.
CACHE_URL=redis://localhost:6379
QUEUE_URL=redis://localhost:6380

PORT=8080
# The three frontends of this environment. Each is the only browser origin allowed to call its own routes, and the base of
# the links emailed to its users. Optional locally (these are the defaults), required in production.
SITE_URL=https://local.terhal.co:3000
DASHBOARD_URL=https://dashboard.local.terhal.co:3000
ADMIN_URL=https://admin.local.terhal.co:3000

# Local https (see the README). On the VPS the edge Caddy terminates TLS, so these are never set there.
TLS_CERT=../../.certs/local.pem
TLS_KEY=../../.certs/local-key.pem

# Email (Resend). Leave RESEND_KEY empty in development to log emails to the console instead.
# Required everywhere else.
RESEND_KEY=
RESEND_EMAIL=

# Seeding (db:seed). Emails an invitation link to the first admin. Only works while no admin exists.
ADMIN_EMAIL=

# Encrypts admins' two-factor secrets in the database. Changing it breaks every admin's existing authenticator setup.
TOTP_ENCRYPTION_KEY=

# Signs the drivers' report links. Changing it breaks every live link; staff then make new ones.
REPORT_LINK_SECRET=

# Signs admin access tokens. Changing it signs every admin out.
ADMIN_SECRET=

# Sign staff and customer access tokens, one secret each. Changing one signs that audience out.
STAFF_SECRET=
CUSTOMER_SECRET=

# Uploaded files (vehicle images, monthly reports). local keeps them in STORAGE_LOCAL_DIR and is only allowed in
# development; staging and production must use s3 (Cloudflare R2) with every S3_ key set, or the server won't start.
STORAGE_DRIVER=local
# Relative to apps/server; git-ignored.
STORAGE_LOCAL_DIR=.storage
# The API's address, the base of the local driver's signed file links.
STORAGE_LOCAL_URL=https://api.local.terhal.co:8080
# Signs the local driver's file links (openssl rand -base64 32). Required with STORAGE_DRIVER=local.
STORAGE_SIGNING_SECRET=

# The s3 driver (Cloudflare R2): the account's S3 endpoint, the private bucket and an API token's keys (Object Read &
# Write on that bucket only). Leave the region as auto for R2.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
