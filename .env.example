# Copy this file to .env and adjust the values as needed: cp .env.example .env
# Docker Compose reads .env automatically and substitutes it into docker-compose.yml.

# General
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend
BACKEND_PORT=8080
APP_SECRET=somerandomsecret1
ADMIN_SECRET=somerandomsecret2
# Email (Resend). Leave RESEND_KEY empty in development to log emails to the console instead.
RESEND_KEY=
RESEND_EMAIL=

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=terhal
POSTGRES_PORT=5432

# Localstack (Main)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
LOCALSTACK_SERVICES=s3
LOCALSTACK_DEBUG=0

# Localstack (S3 Bucket)
S3_BUCKET=terhal
