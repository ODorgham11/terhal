enum AdminStatus {
  ACTIVE
  INACTIVE
}

model Admin {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String      @unique
  status    AdminStatus @default(ACTIVE)

  passwordHash String

  totpSecret       String?
  totpEnabledAt    DateTime?
  totpLastUsedStep Int?
  lastLoginAt      DateTime?

  sessions    AdminSession[]
  auditLogs   AuditLog[]
  invitations AdminInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInvitation {
  id String @id @default(cuid())

  email     String
  tokenHash String @unique

  // Empty for invitations sent by the seed, which runs before any admin exists.
  invitor   Admin?  @relation(fields: [invitorId], references: [id])
  invitorId String?

  // The two-factor secret being set up while accepting, encrypted. It moves to the admin once they confirm a code.
  totpSecret String?

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
}

model AdminSession {
  id           String @id @default(cuid())
  refreshToken String @unique
  adminId      String
  admin        Admin  @relation(fields: [adminId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?
}

model AuditLog {
  id String @id @default(cuid())

  // Who did it. Empty when no admin is behind the event: the seed sending an invitation, or a failed sign in
  // for an email that doesn't belong to any admin.
  admin   Admin?  @relation(fields: [adminId], references: [id])
  adminId String?

  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}
